# ║  𓅂𝐃𝚯𝐌𝚫 𝐋𝐔𝐂𝐈𝐅𝚵𝐑𝐎 — Configuration .env ║
# ╚══════════════════════════════════════════╝
BOT_NAME=𓅂𝐃𝚯𝐌𝚫 𝐋𝐔𝐂𝐈𝐅𝚵𝐑𝚯𓅂
OWNER_NUMBER=
PHONE_NUMBER=
PREFIX=.
SESSION_NAME=lucifer-session
# Sur un hébergeur avec disque persistant, configurez ces deux chemins.
BOT_DATA_DIR=
WHATSAPP_SESSION_PATH=
VERSION=2.1.0

# Dashboard
WEB_PORT=3000
# Required for the separate SaaS panel; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@lucifero.bot
MOD_PASSWORD=7217afis
SUPPORT_PASSWORD=7217afis
ADMIN_PASSWORD=7217afis
PANEL_PASSWORD=7217afis
INTERNAL_TOKEN=
PANEL_PORT=4000

# IA principale — https://aimodelapi.onrender.com/v1
AIMODEL_API_KEY=
AIMODEL_BASE_URL=https://aimodelapi.onrender.com/v1
AI_MODEL=dev-x
AI_IMAGE_MODEL=image-gen
AI_TIMEOUT_MS=30000

# IA de secours rapide
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HNSEC — volontairement en pause
HNSEC_ENABLED=false
HNSEC_API_KEY=

# Automatisations
AUTO_VIEW_STATUS=false

# Médias
