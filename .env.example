# ╔══════════════════════════════════════════╗
# ║  𓅂𝐃𝚯𝐌𝚫 𝐋𝐔𝐂𝐈𝐅𝚵𝐑𝚯𓅂 — Configuration .env ║
# ╚══════════════════════════════════════════╝
# Copiez ce fichier en ".env" et remplissez les valeurs

# ── Bot WhatsApp ────────────────────────────────────────────────────────────────
BOT_NAME=𓅂𝐃𝚯𝐌𝚫 𝐋𝐔𝐂𝐈𝐅𝚵𝐑𝚯𓅂
OWNER_NUMBER=584265781353
PREFIX=.
SESSION_NAME=lucifer-session
VERSION=2.1.0

# ── Dashboard Web Admin ─────────────────────────────────────────────────────────
WEB_PORT=3000
ADMIN_PASSWORD=lucifer2024
# ⚠️  IMPORTANT: Changez ce mot de passe!

# ── Panel SaaS (optionnel) ─────────────────────────────────────────────────────
PANEL_PORT=4000
INTERNAL_TOKEN=lucifer-internal-2024
# ⚠️  Changez ce token aussi!

# ── Connexion: Pair Code (QR désactivé) ────────────────────────────────────────
# Pour connecter le bot à WhatsApp:
# 1. Démarrez le bot (npm start)
# 2. Ouvrez le dashboard (http://localhost:WEB_PORT)
# 3. Entrez votre numéro → cliquez "Générer le Code"
# 4. Entrez le code dans WhatsApp → Appareils liés → Lier avec numéro

# ── Automatisations ─────────────────────────────────────────────────────────────
AUTO_VIEW_STATUS=false
# Mettre 'true' pour voir automatiquement les statuts WhatsApp

# ── IA — Groq (GRATUIT — Llama3, Mixtral) ──────────────────────────────────────
# Créez votre clé gratuite sur: https://console.groq.com/keys
GROQ_API_KEY=

# ── IA — Google Gemini (GRATUIT) ────────────────────────────────────────────────
# Créez votre clé gratuite sur: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── IA — OpenAI (optionnel, payant) ────────────────────────────────────────────
# OPENAI_API_KEY=

# ── Téléchargement — RapidAPI (optionnel) ───────────────────────────────────────
# Pour ytmp3/ytmp4 et TikTok HD
# RAPIDAPI_KEY=

# ── Notes ────────────────────────────────────────────────────────────────────────
# Démarrez avec: npm start
# Dashboard: http://localhost:WEB_PORT (défaut: 3000)
# Pair Code est la SEULE méthode de connexion (QR désactivé)

# ── Médias DOMA (photos, musiques, vidéos) ─────────────────────────────────────
# Photo de profil officielle du bot
BOT_PROFILE_PIC_URL=

# Photos personnelles DOMA (uploadez sur imgur.com/imgbb.com)
DOMA_PHOTO_1=
DOMA_PHOTO_2=
DOMA_PHOTO_3=
# ... jusqu'à DOMA_PHOTO_20

# Musiques MP3 (URLs directes vers fichiers MP3 publics)
DOMA_MUSIC_1=
DOMA_MUSIC_2=
DOMA_MUSIC_3=
DOMA_MUSIC_4=

# Vidéos MP4 (URLs directes vers fichiers MP4 publics)
DOMA_VIDEO_1=
DOMA_VIDEO_2=
DOMA_VIDEO_3=
