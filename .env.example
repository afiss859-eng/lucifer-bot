# ╚══════════════════════════════════════════╝
# Copiez ce fichier en ".env" et remplissez les valeurs

# ── Bot WhatsApp ────────────────────────────────────────────────────────────────
BOT_NAME=𓅂𝐃𝚯𝐌𝚫 𝐋𝐔𝐂𝐈𝐅𝚵𝐑𝚯𓅂
OWNER_NUMBER=584265781353
PREFIX=.
SESSION_NAME=lucifer-session
VERSION=2.0.0

# ── Dashboard Web Admin ─────────────────────────────────────────────────────────
WEB_PORT=3000
ADMIN_PASSWORD=lucifer2024
# Changez ce mot de passe par défaut!

# ── IA — Groq (GRATUIT — Llama3, Mixtral) ──────────────────────────────────────
# Créez votre clé gratuite sur: https://console.groq.com/keys
GROQ_API_KEY=

# ── IA — Google Gemini (GRATUIT) ────────────────────────────────────────────────
# Créez votre clé gratuite sur: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── IA — OpenAI (optionnel, payant) ────────────────────────────────────────────
# OPENAI_API_KEY=

# ── Téléchargement — RapidAPI (optionnel) ───────────────────────────────────────
# Pour ytmp3/ytmp4 et TikTok HD
# Créez un compte sur: https://rapidapi.com
# RAPIDAPI_KEY=

# ── Notes ────────────────────────────────────────────────────────────────────────
# Après configuration, démarrez avec: npm start
# Dashboard accessible sur: http://localhost:3000
# Connexion: QR code ou Pair Code (recommandé sur serveur)
